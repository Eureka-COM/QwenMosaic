{
 "name": "mq-diag-teachers",
 "purpose": "docs/plan-mosaic-qwen.md §10 診断 2：同じ規模の別のモデル（Qwen3-0.6B-Base、MiniCPM5-1B。どちらも全層が softmax 注意）で、全層を公式 Memory Mosaics の層に置き換えたときの層合わせの誤差を、診断 1 と同じ設定・同じデータ・同じ対照つきで測る。先生（蒸留の元）によって記憶の合わせやすさが変わるかを見る。各 10e6 トークン。モデルは保存しない（計測のみ）",
 "save_mode": "token",
 "auto_stop": false,
 "max_minutes": 180,
 "save_every_min": 10,
 "max_parallel": 1,
 "require_gpu": [
  "A100",
  "H100",
  "H200",
  "B200",
  "RTX PRO 6000",
  "RTX 5090"
 ],
 "setup": {
  "pip": [
   "transformers>=5.2,<6",
   "pyarrow",
   "flash-linear-attention",
   "datasets",
   "safetensors",
   "ninja",
   "accelerate"
  ],
  "models": [
   "Qwen/Qwen3-0.6B-Base",
   "openbmb/MiniCPM5-1B"
  ],
  "data": [
   {
    "repo": "HuggingFaceTB/cosmopedia-100k",
    "file": "data/train-00000-of-00002.parquet",
    "dir": "/content/data/cosmopedia-100k"
   },
   {
    "repo": "HuggingFaceH4/ultrachat_200k",
    "file": "data/train_sft-00000-of-00003-a3ecf92756993583.parquet",
    "dir": "/content/data/ultrachat"
   },
   {
    "repo": "wikimedia/wikipedia",
    "file": "20231101.ja/train-00014-of-00015.parquet",
    "dir": "/content/data/wikipedia-ja"
   },
   {
    "repo": "codeparrot/codeparrot-clean-valid",
    "file": "file-000000000054.json.gz",
    "dir": "/content/data/codeparrot"
   }
  ]
 },
 "runs": [
  {
   "name": "fit-qwen3",
   "script": "scripts/mq_stage1_control.py",
   "gpu_gb": 20,
   "max_minutes": 80,
   "args": [
    "--model",
    "/content/models/Qwen3-0.6B-Base",
    "--data",
    "/content/data/cosmopedia-100k@4",
    "--data",
    "/content/data/ultrachat:messages@2",
    "--data",
    "/content/data/wikipedia-ja@2",
    "--data",
    "/content/data/codeparrot:content@1",
    "--docs",
    "60000",
    "--short-heads",
    "8",
    "--long-heads",
    "8",
    "--replace",
    "all",
    "--seq-len",
    "2048",
    "--bsz",
    "8",
    "--tokens",
    "10e6",
    "--lr",
    "1e-3",
    "--control-lr",
    "1e-3,3e-4",
    "--warmup",
    "50",
    "--eval-every",
    "150",
    "--eval-rows",
    "8"
   ],
   "output_files": [
    "result.json",
    "run.json"
   ],
   "no_common": true
  },
  {
   "name": "fit-minicpm5",
   "script": "scripts/mq_stage1_control.py",
   "gpu_gb": 20,
   "max_minutes": 80,
   "args": [
    "--model",
    "/content/models/MiniCPM5-1B",
    "--data",
    "/content/data/cosmopedia-100k@4",
    "--data",
    "/content/data/ultrachat:messages@2",
    "--data",
    "/content/data/wikipedia-ja@2",
    "--data",
    "/content/data/codeparrot:content@1",
    "--docs",
    "60000",
    "--short-heads",
    "12",
    "--long-heads",
    "12",
    "--replace",
    "all",
    "--seq-len",
    "2048",
    "--bsz",
    "8",
    "--tokens",
    "10e6",
    "--lr",
    "1e-3",
    "--control-lr",
    "1e-3,3e-4",
    "--warmup",
    "50",
    "--eval-every",
    "150",
    "--eval-rows",
    "8"
   ],
   "output_files": [
    "result.json",
    "run.json"
   ],
   "no_common": true
  }
 ],
