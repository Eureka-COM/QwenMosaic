 "max_minutes": 100,
 "save_mode": "token",
 "auto_stop": false,
 "export_token": true,
 "save_every_min": 10,
 "max_parallel": 2,
 "stagger_sec": 30,
 "gpu_frac": 0.92,
 "require_gpu": [
  "A100",
  "H100",
  "H200",
  "B200",
  "RTX PRO 6000",
  "RTX 5090"
 ],
 "setup": {
  "pip": [
   "transformers>=5.2,<6",
   "pyarrow",
   "flash-linear-attention",
   "datasets",
   "safetensors",
   "ninja",
   "accelerate"
  ],
  "models": [
   "Qwen/Qwen3.5-0.8B"
  ],
  "data": [
   {
    "repo": "HuggingFaceTB/cosmopedia-100k",
    "file": "data/train-00000-of-00002.parquet",
