{
 "name": "mq-27b-all-probe",
 "purpose": "docs/plan-mosaic-qwen.md §10 手順 3：Qwen3.8-27B の全 64 層を公式 Memory Mosaics の層に置き換えたときの、段1 と段2 の 1 ステップの速さと最大メモリを B200 で測る（16+16 ヘッドと 40+40 ヘッド）。学習はしない",
 "save_mode": "token",
 "auto_stop": true,
 "max_minutes": 40,
 "save_every_min": 5,
 "max_parallel": 1,
 "require_gpu": [
  "B200",
  "B300",
  "H200"
 ],
 "setup": {
  "pip": [
   "transformers>=5.2,<6",
   "pyarrow",
   "flash-linear-attention",
   "datasets",
   "safetensors",
   "ninja",
   "accelerate"
  ],
  "models": [
   "Qwen/Qwen3.8-27B"
  ]
 },
 "runs": [
  {
   "name": "env27-all-16",
   "script": "scripts/mq_env.py",
   "wait": true,
   "max_minutes": 14,
   "args": [
    "--model",
    "/content/models/Qwen3.8-27B",
    "--seq",
    "2048",
    "--bsz",
    "2",
    "--short-heads",
    "16",
    "--long-heads",
    "16",
    "--replace",
    "all",
    "--steps",
    "3",
    "--stage2",
    "--grad-checkpoint",
    "--lora-r",
    "32"
   ],
   "output_files": [
    "env.json"
   ],
   "no_common": true
  },
  {
   "name": "env27-all-40",
   "script": "scripts/mq_env.py",
   "wait": true,
   "max_minutes": 14,
   "args": [
    "--model",
    "/content/models/Qwen3.8-27B",
    "--seq",
    "2048",
    "--bsz",
    "2",
    "--short-heads",
    "40",
    "--long-heads",
    "40",
    "--replace",
    "all",
    "--steps",
    "3",
    "--stage2",
    "--grad-checkpoint",
    "--lora-r",
    "32"
   ],
   "output_files": [
    "env.json"
   ],
   "no_common": true
  }
 ],
 "premises_sha": "8c8c8df9a368a1d8a220888753a99fe50570b6843d4bd7e182c0c10e1134d6f8"
}
