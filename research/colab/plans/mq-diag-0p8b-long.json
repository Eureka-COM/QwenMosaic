{
 "name": "mq-diag-0p8b-long",
 "purpose": "docs/plan-mosaic-qwen.md §10 夜間の長い学習：診断 3〜5 で効いたものを合わせる。手順 1 の段1 の結果から、全部の重みを動かし、損失は KL + 0.5 × 次トークンの損失、学習量は 160e6 トークン（手順 1 の段2 の 4 倍）。全層を公式 Memory Mosaics の層に置き換えた 0.8B が、この組み合わせで合格の線にどこまで近づくかを見る",
 "save_mode": "token",
 "auto_stop": true,
 "export_token": true,
 "max_minutes": 380,
 "save_every_min": 10,
 "max_parallel": 1,
 "gpu_frac": 0.92,
 "require_gpu": [
  "A100",
  "H100",
  "H200",
  "B200",
  "RTX PRO 6000",
  "RTX 5090"
 ],
 "setup": {
  "pip": [
   "transformers>=5.2,<6",
   "pyarrow",
   "flash-linear-attention",
   "datasets",
   "safetensors",
   "ninja",
   "accelerate"
  ],
  "models": [
   "Qwen/Qwen3.5-0.8B"
  ],
  "data": [
   {
    "repo": "HuggingFaceTB/cosmopedia-100k",
    "file": "data/train-00000-of-00002.parquet",
    "dir": "/content/data/cosmopedia-100k"
   },
   {
    "repo": "HuggingFaceH4/ultrachat_200k",
    "file": "data/train_sft-00000-of-00003-a3ecf92756993583.parquet",
    "dir": "/content/data/ultrachat"
   },
   {
    "repo": "wikimedia/wikipedia",
    "file": "20231101.ja/train-00014-of-00015.parquet",
    "dir": "/content/data/wikipedia-ja"
   },
   {
    "repo": "codeparrot/codeparrot-clean-valid",
    "file": "file-000000000054.json.gz",
    "dir": "/content/data/codeparrot"
   }
  ]
 },
 "runs": [
  {
   "name": "fetch-all-s1",
   "script": "scripts/mq_fetch.py",
   "max_minutes": 15,
   "args": [
    "--store",
    "github-release:mq-all-0p8b-s1",
    "--dest",
    "/content/prev/all-s1/delta",
    "--require-tag",
    "done"
   ],
   "no_common": true
  },
  {
   "name": "long-all",
   "script": "scripts/mq_stage2.py",
   "after": [
    "fetch-all-s1"
   ],
   "gpu_gb": 24,
   "max_minutes": 330,
   "args": [
    "--model",
    "/content/models/Qwen3.5-0.8B",
    "--data",
    "/content/data/cosmopedia-100k@4",
    "--data",
    "/content/data/ultrachat:messages@2",
    "--data",
    "/content/data/wikipedia-ja@2",
    "--data",
    "/content/data/codeparrot:content@1",
    "--docs",
    "60000",
    "--delta-in",
    "/content/prev/all-s1/delta",
    "--train",
    "all",
    "--lr-base",
    "1e-5",
    "--grad-checkpoint",
    "--seq-len",
    "2048",
    "--bsz",
    "8",
    "--positions",
    "512",
    "--tokens",
    "160e6",
    "--lr",
    "1e-4",
    "--warmup",
    "30",
    "--ce-weight",
    "0.5",
    "--eval-every",
    "300",
    "--eval-rows",
    "8",
    "--store",
    "github-release:mq-diag-0p8b-long",
    "--shard-mb",
    "1900",
    "--no-optim-save",
    "--save-every-min",
    "20"
   ],
   "output_files": [
    "delta/mq_config.json",
    "result.json"
   ],
   "no_common": true
  },
  {
   "name": "evalc-long-all",
   "script": "scripts/mq_eval.py",
   "after": [
    "long-all"
   ],
   "gpu_gb": 8,
   "max_minutes": 25,
   "args": [
    "--model",
    "/content/models/Qwen3.5-0.8B",
    "--data",
    "/content/data/cosmopedia-100k@4",
    "--data",
    "/content/data/ultrachat:messages@2",
    "--data",
    "/content/data/wikipedia-ja@2",
    "--data",
    "/content/data/codeparrot:content@1",
    "--docs",
    "60000",
    "--delta",
    "/content/out/long-all/delta",
    "--eval-rows",
    "16",
    "--recall-distances",
    "32,512,1500,6000",
    "--recall-n",
    "20",
    "--no-samples"
   ],
   "output_files": [
    "metrics.json",
    "recall.json"
   ],
   "no_common": true
  }
 ],
 "premises_sha": "8c8c8df9a368a1d8a220888753a99fe50570b6843d4bd7e182c0c10e1134d6f8"
}
