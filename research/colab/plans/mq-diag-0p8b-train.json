{
 "name": "mq-diag-0p8b-train",
 "purpose": "docs/plan-mosaic-qwen.md §10 診断 3〜5：手順 1 のモデル（全 24 層置き換え、8+8 ヘッド）で、段2 と同じ大きさ（40e6 トークン、同じ行）の学習を 3 通り行う。cont-kl＝手順 1 の最終モデルから同じ蒸留を続ける（学習量）、all-kl＝段1 の結果から全部の重みを動かして蒸留する（LoRA の制約）、all-ce＝同じく全部の重みを動かし、蒸留なしで次トークンの損失だけで学習する（蒸留かどうか）。どれも学習に使っていない 16 行で、手順 1 の段2 の結果と比べる",
 "save_mode": "token",
 "auto_stop": true,
 "export_token": true,
 "max_minutes": 330,
 "save_every_min": 10,
 "max_parallel": 3,
 "stagger_sec": 30,
 "gpu_frac": 0.92,
 "require_gpu": [
  "A100",
  "H100",
  "H200",
  "B200",
  "RTX PRO 6000",
  "RTX 5090"
 ],
 "setup": {
  "pip": [
   "transformers>=5.2,<6",
   "pyarrow",
   "flash-linear-attention",
   "datasets",
   "safetensors",
   "ninja",
   "accelerate"
  ],
  "models": [
   "Qwen/Qwen3.5-0.8B"
  ],
  "data": [
   {
    "repo": "HuggingFaceTB/cosmopedia-100k",
    "file": "data/train-00000-of-00002.parquet",
    "dir": "/content/data/cosmopedia-100k"
   },
   {
    "repo": "HuggingFaceH4/ultrachat_200k",
    "file": "data/train_sft-00000-of-00003-a3ecf92756993583.parquet",
