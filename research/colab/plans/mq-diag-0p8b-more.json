    "8",
    "--long-heads",
    "8",
    "--replace",
    "all",
    "--seq-len",
    "2048",
    "--bsz",
    "8",
    "--tokens",
    "10e6",
    "--warmup",
    "50",
    "--eval-every",
    "150",
    "--eval-rows",
    "8",
    "--no-optim-save",
    "--shard-mb",
    "1900",
    "--lr",
    "2e-3"
   ],
   "output_files": [
    "delta/mq_config.json",
    "result.json",
    "run.json"
   ],
   "no_common": true
  },
  {
